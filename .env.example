# Optional environment-variable overrides for the dataset location.
# These are the ONLY variables the code reads (via os.getenv in
# src/data_loader.py and src/spark_preprocess.py). Model and training
# hyperparameters are NOT set here — they live in configs/*.json.
#
# This file is not auto-loaded. Export the variables or source it before
# running, e.g.:  set -a; source .env; set +a

# Directory holding the raw dataset, relative to the repo root.
DATA_DIR=data

# Raw dataset filename inside DATA_DIR.
RAW_DATA_FILE=Friday-WorkingHours-Afternoon-DDos.pcap_ISCX.csv.zip

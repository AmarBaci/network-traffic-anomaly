# Copy this file to .env and fill in values for your local environment.
# Do not commit .env with real credentials.

# Project mode: dev | test | prod
APP_ENV=dev

# Reproducibility
RANDOM_SEED=42

# Data paths
DATA_DIR=data
RAW_DATA_FILE=Friday-WorkingHours-Afternoon-DDos.pcap_ISCX.csv.zip

# Training defaults
BATCH_SIZE=256
EPOCHS=20
LEARNING_RATE=0.001

# Optional tracking/logging
EXPERIMENT_NAME=baseline-ssl
